# Desarrollo: SQLite. Producción: Postgres (ver docs/DEPLOY.md)
DATABASE_URL=sqlite:///./facturas.db
# DATABASE_URL=postgresql+psycopg://dte_app:<clave>@<host>:5432/dte

# Proveedor LLM: openrouter (default) o anthropic
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Servidor MCP por HTTP: hash del token (generar con: uv run python -m mcp_server.http_server --nuevo-token)
MCP_TOKEN_SHA256=

# API: hash de la API key (generar con: uv run python -m app.api.seguridad). Vacío = API abierta (solo desarrollo)
API_KEY_SHA256=

# Observabilidad (tarjeta 11): none | langsmith | langfuse. Ver docs/observabilidad.md
OBS_PROVIDER=none
# true = no envía el texto de la factura al proveedor de trazas
OBS_OCULTAR_CONTENIDO=false

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-demo-dte

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # región US: https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development      # en el servidor: production
