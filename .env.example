DATABASE_URL=sqlite:///./facturas.db

# Proveedor LLM: openrouter (default) o anthropic
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Servidor MCP por HTTP: hash del token (generar con: uv run python -m mcp_server.http_server --nuevo-token)
MCP_TOKEN_SHA256=
