{
  "name": "Ingesta de facturas DTE (formulario)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const salida = [];\nfor (const item of $input.all()) {\n  for (const bin of Object.values(item.binary ?? {})) {\n    const nombre = (bin.fileName || '').toLowerCase();\n    if (nombre.endsWith('.pdf') || nombre.endsWith('.xml')) {\n      salida.push({\n        json: {\n          remitente: item.json.from,\n          asunto: item.json.subject,\n          archivo: bin.fileName,\n        },\n        binary: { archivo: bin },\n      });\n    }\n  }\n}\nreturn salida;"
      },
